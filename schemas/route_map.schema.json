{
  "$comment": "确定性路由映射表的字段契约。此前 exclude/match_type 等字段无任何声明，拼错字段名不会报错。真源消费方：tools/hook_route_match.py、tools/audit_routing.py、lint_workspace.py 第 16 项。",
  "title": "route_map",
  "target": ".system/rules/route_map.json",
  "type": "object",
  "required": ["_meta", "routes"],
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["purpose", "source_of_truth"],
      "additionalProperties": true,
      "properties": {
        "purpose": { "type": "string" },
        "source_of_truth": { "type": "string" },
        "deliberate_omissions": { "type": "string" },
        "exclude_semantics": { "type": "string" }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mechanism", "files", "anchor", "keywords"],
        "additionalProperties": false,
        "properties": {
          "mechanism": { "type": "string", "minLength": 1 },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^\\.system/rules/.+\\.md$" }
          },
          "anchor": { "type": "string", "minLength": 1 },
          "match_type": { "type": "string", "enum": ["substring", "exact"] },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exclude": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}

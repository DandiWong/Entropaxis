{
  "$comment": "事务胶囊清单契约。物理宿主：各胶囊目录 capsule.yaml；写入方 init_capsule.py（模板）/ update_capsule.py（log_time 追加 worklogs）。消费方：tools/aggregate_worklog.py（条目校验与聚合）、tools/lint_workspace.py（胶囊检查项）。date 字段必须写成带双引号的 YAML 标量：未加引号的裸日期会被 PyYAML 解析为 datetime.date，直接违反本契约的 type: string。",
  "title": "capsule",
  "target": "**/capsule.yaml",
  "type": "object",
  "required": ["id", "topic", "mode", "lifecycle"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z]+-\\d+$" },
    "topic": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["draft", "active", "delivered", "archived", "archived-unmeasured"] },
    "seq_next": {
      "type": "integer",
      "minimum": 1,
      "description": "胶囊内段与工时条目单调递增序号计数器"
    },
    "owner": {
      "$comment": "胶囊归属（Tech-175 M0，方案 6.4 P0）：取值 = stakeholders.yaml::people[].id。可选，缺省时由聚合层按首个 actor≠role 的段 operator 经 handles.git 映射推导，只展示不回写。",
      "type": "string",
      "minLength": 1
    },
    "members": {
      "$comment": "胶囊成员（Tech-175 M0，方案 6.4 P0）：people.id 列表；「我的」过滤按 owner 或 members 命中。",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "task_segments": {
      "type": "array",
      "description": "会话事件时间戳驱动的任务段事实集合",
      "items": {
        "type": "object",
        "required": ["seq", "seg_id", "name", "startAt", "lastActivityAt", "state"],
        "additionalProperties": false,
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "seg_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+#\\d+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "taskId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "stage": { "type": "string", "pattern": "^(\\d{2}_\\S+|misc)$" },
          "startAt": { "type": "string", "format": "date-time" },
          "endAt": { "type": "string", "format": "date-time" },
          "lastActivityAt": { "type": "string", "format": "date-time" },
          "trigger": { "type": "string", "enum": ["deliver", "delivered", "uat", "verbal", "switch", "inferred", "dispatch", "manager"] },
          "inferred": { "type": "boolean" },
          "evidence": { "type": "string" },
          "state": { "type": "string", "enum": ["open", "pending_approval", "logged", "unmeasured", "failed"] },
          "note": { "type": "string" },
          "actor": {
            "$comment": "执行主体：role=角色调度段（自开自结）、manager=Manager 事务段；缺省=升级前旧段，按旧语义收尾。",
            "type": "string",
            "enum": ["role", "manager"]
          },
          "role": {
            "$comment": "actor=role 时必带（update_capsule 写前校验）；取值同 roles_manifest.schema.json 的 role 枚举。",
            "type": "string",
            "enum": ["Architecture", "Researcher", "Designer", "Builder", "Reviewer", "Maintainer", "Reporter"]
          },
          "dispatch_id": {
            "$comment": "run 级调度 ID（uuid4 hex），actor=role 时必带；同一胶囊内唯一。",
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "baseline": {
            "$comment": "Manager 段开段时的胶囊文件指纹：{相对路径: sha256 前 16 位}；不含 capsule.yaml 与点开头路径。",
            "type": "object",
            "patternProperties": { ".+": { "type": "string", "pattern": "^[0-9a-f]{16}$" } }
          },
          "evidence_sha256": {
            "$comment": "Manager 段结段时证据文件的 sha256 前 16 位，须与 baseline 中不同。",
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "machine_seconds": {
            "$comment": "段墙钟时长（秒）：max(1, round(endAt − startAt))，结段时写入。",
            "type": "integer",
            "minimum": 1
          },
          "effective_seconds": {
            "$comment": "有效秒（角色段扣失败 attempt、Manager 段扣重叠与尾部空档），只有 actor 段有；门槛判定与入账都读它。",
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "worklogs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "stage", "spent", "summary", "operator"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "stage": { "type": "string", "pattern": "^(\\d{2}_\\S+|misc)$" },
          "spent": {
            "$comment": "派生字段：round(seconds/3600, 4)；旧条目无 seconds 时为唯一真源（0.25 步长已随秒级化删除）。",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 24
          },
          "seconds": {
            "$comment": "工时真源（整数秒，等于段的 effective_seconds）；schema 可选、工具新写必带，旧条目由汇总补算。",
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "actor": {
            "$comment": "执行主体；旧条目缺省视为「未标注」，汇总不推断。",
            "type": "string",
            "enum": ["role", "manager", "human"]
          },
          "role": {
            "$comment": "actor=role 时必带（update_capsule 写前校验）。",
            "type": "string",
            "enum": ["Architecture", "Researcher", "Designer", "Builder", "Reviewer", "Maintainer", "Reporter"]
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
          "operator": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]+#\\d+$" },
          "overridden": { "type": "boolean" },
          "original_spent": { "type": "number", "exclusiveMinimum": 0, "maximum": 24 },
          "original_seconds": {
            "$comment": "首次覆盖时保存（无 seconds 则按 round(original_spent×3600) 补算）。",
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "original_stage": { "type": "string", "pattern": "^(\\d{2}_\\S+|misc)$" },
          "original_summary": { "type": "string" },
          "override_reason": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "胶囊对外部客观资产、原型或前序标准的显式依赖与数字指纹",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "captured_at": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}

{
  "$comment": "角色有序偏好配置。roles.preferences 是 command_profiles 标识的有序列表，序号从 1 起；profile 是选中标识或 null（未选中，不代表硬门禁外置就绪）。agent/model 是调用真源；provider/model 前缀原样保留。旧实例须显式迁移；bootstrap 仅首次渲染，真实模型检测须单独取得用户授权。",
  "title": "roles_config",
  "target": "data/templates/roles.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["roles", "command_profiles"],
  "properties": {
    "_meta": { "type": "object", "required": ["source", "managed_by", "policy"] },
    "default_dispatch_mode": { "enum": ["strict", "graceful"] },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Z][A-Za-z]*$": {
          "type": "object",
          "required": ["duty", "preferences", "profile"],
          "additionalProperties": false,
          "properties": {
            "duty": { "type": "string", "minLength": 1 },
            "preferences": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            },
            "profile": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$" }
          }
        }
      }
    },
    "command_profiles": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": { "$ref": "command_profile.schema.json#/patternProperties/^[a-z][a-z0-9-]*$" }
      }
    },
    "dispatch_authorizations": { "type": "array" }
  }
}

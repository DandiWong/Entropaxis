{
  "title": "workspace-config",
  "target": "data/templates/workspace-config.yaml",
  "type": "object",
  "properties": {
    "_meta": {
      "type": "object",
      "required": [
        "source",
        "managed_by",
        "policy"
      ]
    },
    "shared_dirs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "dir",
          "purpose"
        ],
        "properties": {
          "dir": {
            "type": "string",
            "minLength": 1
          },
          "kb": {
            "type": "boolean",
            "description": "可选；true 表示该共享目录按知识库根纳入 lint [知识库根散落] 体检"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "remotes": {
      "type": "array",
      "description": "远端存储定义（Tech-175 M0，方案 6.4 P0）：只描述连接目标与开关，凭据走系统钥匙串，不进任何配置文件（6.7）。",
      "items": {
        "type": "object",
        "required": ["id", "protocol", "endpoint", "bucket_or_root"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "远端标识，被 registry.yaml::projects[].remote 引用" },
          "protocol": {
            "type": "string",
            "enum": ["s3", "oss", "webdav"],
            "description": "s3=AWS S3 或兼容 API；oss=阿里云 OSS；webdav=标准 WebDAV"
          },
          "endpoint": { "type": "string", "minLength": 1, "description": "服务端点（不含桶名与路径）" },
          "bucket_or_root": { "type": "string", "minLength": 1, "description": "桶名或根路径" },
          "region": { "type": "string", "description": "区域（S3/OSS 用）" },
          "encrypt": {
            "type": "boolean",
            "description": "按项目开关的客户端加密（D-4）；缺省 false"
          }
        }
      }
    },
    "org": {
      "type": "object"
    }
  }
}

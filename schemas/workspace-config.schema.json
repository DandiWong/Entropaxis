{
  "title": "workspace-config",
  "target": "data/templates/workspace-config.yaml",
  "type": "object",
  "properties": {
    "_meta": {
      "type": "object",
      "required": [
        "source",
        "managed_by",
        "policy"
      ]
    },
    "shared_dirs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "dir",
          "purpose"
        ],
        "properties": {
          "dir": {
            "type": "string",
            "minLength": 1
          },
          "kb": {
            "type": "boolean",
            "description": "可选；true 表示该共享目录按知识库根纳入 lint [知识库根散落] 体检"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "org": {
      "type": "object"
    }
  }
}
